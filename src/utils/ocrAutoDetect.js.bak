import Tesseract from 'tesseract.js';
import sharp from 'sharp';
import { cleanPlayerNameOCR, parseScore } from './nameMatching.js';

/**
 * Convertit une image base64 en buffer
 */
function base64ToBuffer(base64String) {
  const base64Data = base64String.replace(/^data:image\/\w+;base64,/, '');
  return Buffer.from(base64Data, 'base64');
}

/**
 * Preprocessing global de l'image pour améliorer l'OCR
 */
async function preprocessImage(imageBuffer) {
  return await sharp(imageBuffer)
    .resize(null, 1800, { 
      withoutEnlargement: true,
      kernel: sharp.kernel.lanczos3 // Meilleur algorithme de resize
    })
    .greyscale()
    .normalize() // Normalisation automatique du contraste
    .sharpen({ sigma: 1.2 }) // Améliore la netteté du texte (moins agressif)
    .png()
    .toBuffer();
}

/**
 * Détecte automatiquement les scores et noms dans un screenshot BBS
 * Utilise l'OCR global avec détection de blocs de texte
 */
export async function processGuildRankingScreenshotAuto(base64Image) {
  try {
    console.log('🔍 Début du traitement OCR automatique...');
    
    const imageBuffer = base64ToBuffer(base64Image);
    const metadata = await sharp(imageBuffer).metadata();
    const { width, height } = metadata;
    
    console.log(`📐 Dimensions image: ${width}x${height}`);
    
    // Preprocessing de l'image complète
    const processedBuffer = await preprocessImage(imageBuffer);
    
    // OCR global avec détection automatique des blocs
    console.log('🔎 Exécution OCR global...');
    const { data } = await Tesseract.recognize(processedBuffer, 'eng', {
      logger: m => {
        if (m.status === 'recognizing text') {
          console.log(`  Progression OCR: ${Math.round(m.progress * 100)}%`);
        }
      },
      tessedit_pageseg_mode: Tesseract.PSM.AUTO, // Détection automatique de la mise en page
      tessedit_ocr_engine_mode: Tesseract.OEM.LSTM_ONLY,
      tessedit_char_whitelist: 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 ,.:éèêàâôùûïç\'"†' // Caractères autorisés
    });
    
    console.log('✅ OCR terminé, analyse des résultats...');
    
    // Debug: afficher le texte brut détecté
    console.log('📄 Texte brut détecté:');
    console.log(data.text || '(vide)');
    console.log('---');
    
    // Parser directement le texte brut au lieu de dépendre de data.words
    const players = parseTextForPlayers(data.text);
    
    // Limiter à 5 joueurs max par screenshot (les screenshots BBS montrent 5 joueurs)
    const limitedPlayers = players.slice(0, 5);
    
    if (players.length > 5) {
      console.log(`\n⚠️  ATTENTION: ${players.length} joueurs détectés, limités à 5 (probablement des faux positifs)`);
    }
    
    console.log(`\n✅ ${limitedPlayers.length} joueurs détectés automatiquement`);
    
    return limitedPlayers;
    
  } catch (error) {
    console.error('❌ Erreur OCR auto:', error);
    throw error;
  }
}

/**
 * Parse le texte brut pour extraire les joueurs et leurs scores
 * Format attendu : "Nom ... Score personnel hebdomadaire : 1,234,567,890"
 */
function parseTextForPlayers(text) {
  if (!text) return [];
  
  const players = [];
  const lines = text.split('\n').map(l => l.trim());
  const processedLines = new Set(); // Pour éviter de traiter la même ligne plusieurs fois
  
  console.log(`\n🔍 Analyse de ${lines.length} lignes de texte...`);
  
  // Debug: afficher toutes les lignes non vides
  console.log('\n📋 Lignes détectées:');
  lines.forEach((line, idx) => {
    if (line) console.log(`  ${idx + 1}: ${line.substring(0, 100)}`);
  });
  console.log('\n');
  
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (!line || processedLines.has(i)) continue;
    
    // Ignorer les lignes avec des rangs/places
    if (/\d+[eère]+\s*place/i.test(line)) {
      console.log(`  ⏭️  Ligne ${i + 1}: Ignorée (rang/place): ${line.substring(0, 60)}`);
      continue;
    }
    
    // Chercher les lignes avec "Score...hebdomadaire" ou simplement un grand nombre
    // Pattern flexible pour gérer les erreurs OCR
    let scoreMatch = line.match(/(?:score|Score).*?(?:personnel|personnet).*?(?:hebdomadaire|hebdomadalre)\s*[:：]?\s*([\d,\s]+)/i);
    
    // Si pas de match avec le pattern complet, chercher juste un grand nombre
    // MAIS uniquement si bien formaté (virgules tous les 3 chiffres)
    if (!scoreMatch) {
      // Chercher un pattern très strict : XXX,XXX,XXX format
      const strictNumberMatch = line.match(/\b(\d{1,3}(?:,\d{3}){2,3})\b/);
      if (strictNumberMatch) {
        const num = strictNumberMatch[1];
        const digitsOnly = num.replace(/[^0-9]/g, '');
        // Au moins 8 chiffres
        if (digitsOnly.length >= 8) {
          scoreMatch = [num, num];
          console.log(`  ℹ️  Ligne ${i + 1}: Nombre bien formaté trouvé (${digitsOnly.length} chiffres) : ${num}`);
        }
      }
    }
    
    if (scoreMatch) {
      console.log(`\n  Ligne ${i + 1}: Score trouvé: ${scoreMatch[1]}`);
      
      const scoreText = scoreMatch[1];
      
      // Chercher le nom dans les 3 lignes précédentes
      let detectedName = null;
      
      // Collecter tous les candidats de noms dans les lignes précédentes
      const nameCandidates = [];
      
      // Chercher dans les 5 lignes précédentes au lieu de 3
      for (let j = Math.max(0, i - 5); j < i; j++) {
        const prevLine = lines[j];
        console.log(`    Vérif ligne ${j + 1}: "${prevLine.substring(0, 80)}"`);
        
        // Extraire TOUS les mots de 2+ caractères alphanumériques (incluant accents et certains symboles)
        const words = prevLine.match(/[a-zA-ZÀ-ÿ†][a-zA-Z0-9À-ÿ_†]{1,}/g) || [];
        
        for (const word of words) {
          // Filtrer les mots communs/système
          if (!/^(place|score|personnel|hebdomadaire|groupe|dans|ligue|general|sous|chef|grade|gradus|ere|eme)/i.test(word)) {
            // Calculer un score de "qualité" basé sur longueur et proximité avec la ligne du score
            const distanceFromScore = i - j;
            const lengthScore = word.length;
            const proximityScore = 4 - distanceFromScore; // Plus proche = meilleur
            const qualityScore = lengthScore + (proximityScore * 2);
            
            nameCandidates.push({ 
              word, 
              line: j + 1, 
              qualityScore,
              distance: distanceFromScore 
            });
          }
        }
      }
      
      // Trier par score de qualité (longueur + proximité)
      nameCandidates.sort((a, b) => b.qualityScore - a.qualityScore);
      
      if (nameCandidates.length > 0) {
        // Prendre le meilleur candidat
        const bestCandidate = nameCandidates[0];
        detectedName = bestCandidate.word;
        console.log(`    ✓ Nom sélectionné: "${detectedName}" (ligne ${bestCandidate.line}, distance: ${bestCandidate.distance}, quality: ${bestCandidate.qualityScore})`);
        console.log(`    Autres candidats: [${nameCandidates.slice(1, 5).map(c => `${c.word}(${c.qualityScore})`).join(', ')}]`);
      }
      
      console.log(`    🔧 Debug: detectedName="${detectedName}", scoreText="${scoreText}"`);
      
      const scoreResult = parseScore(scoreText);
      console.log(`    🔧 parseScore result:`, scoreResult);
      
      const parsedScore = scoreResult?.value || null;
      
      if (detectedName && parsedScore && parsedScore > 0) {
        // Vérifier qu'on n'a pas déjà ce score (éviter les doublons)
        const isDuplicate = players.some(p => Math.abs(p.score - parsedScore) < 1000);
        
        if (isDuplicate) {
          console.log(`  ⚠️  Score en doublon ignoré: ${parsedScore.toLocaleString('fr-FR')}`);
        } else {
          const cleanedName = cleanPlayerNameOCR(detectedName);
          console.log(`    🔧 Après cleanPlayerNameOCR: "${cleanedName}"`);
          
          console.log(`  ✅ Joueur ${players.length + 1}: "${cleanedName}" → ${parsedScore.toLocaleString('fr-FR')}`);
          
          players.push({
            lineNumber: players.length + 1,
            detectedName: cleanedName,
            score: parsedScore,
            confidence: 85,
            hasValidName: cleanedName && cleanedName.length > 0,
            hasValidScore: parsedScore !== null && parsedScore > 0,
            bbox: {
              name: { x0: 0, y0: 0, x1: 0, y1: 0 },
              score: { x0: 0, y0: 0, x1: 0, y1: 0 }
            }
          });
          
          // Marquer cette ligne comme traitée
          processedLines.add(i);
        }
      } else {
        console.log(`  ⚠️  Score sans nom valide détecté`);
      }
    }
  }
  
  console.log(`\n🎯 Résultat final: ${players.length} joueurs détectés`);
  players.forEach((p, idx) => {
    console.log(`  ${idx + 1}. ${p.detectedName} - ${p.score.toLocaleString('fr-FR')}`);
  });
  
  return players;
}

/**
 * ANCIENNE VERSION - Utilise les structures de mots de Tesseract
 * Conservée pour référence mais non utilisée
 */
function parseWithWordStructures(data) {
    // Debug: structure de data
    console.log('🔍 Structure de data:', {
      hasWords: !!data.words,
      wordsLength: data.words?.length || 0,
      hasLines: !!data.lines,
      linesLength: data.lines?.length || 0,
      hasParagraphs: !!data.paragraphs,
      paragraphsLength: data.paragraphs?.length || 0,
      hasBlocks: !!data.blocks,
      blocksLength: data.blocks?.length || 0
    });
    
    // Extraire tous les mots depuis data.words (structure plate)
    let allWords = [];
    
    if (data.words && data.words.length > 0) {
      console.log('✓ Utilisation de data.words (structure plate)');
      allWords = data.words;
    } else if (data.lines && data.lines.length > 0) {
      console.log('✓ Utilisation de data.lines.words (structure hiérarchique)');
      data.lines.forEach((line) => {
        if (line.words) {
          line.words.forEach(word => {
            allWords.push(word);
          });
        }
      });
    } else if (data.blocks && data.blocks.length > 0) {
      console.log('✓ Utilisation de data.blocks → paragraphs → lines → words');
      data.blocks.forEach(block => {
        if (block.paragraphs) {
          block.paragraphs.forEach(para => {
            if (para.words) {
              para.words.forEach(word => allWords.push(word));
            } else if (para.lines) {
              para.lines.forEach(line => {
                if (line.words) {
                  line.words.forEach(word => allWords.push(word));
                }
              });
            }
          });
        }
      });
    }
    
    console.log(`📝 ${allWords.length} mots extraits`);
    
    // Debug: afficher les premiers mots
    if (allWords.length > 0) {
      console.log('🔍 Premiers mots détectés:');
      allWords.slice(0, 15).forEach((w, i) => {
        console.log(`  ${i + 1}. "${w.text}" (confiance: ${Math.round(w.confidence)}%) [${w.bbox?.x0},${w.bbox?.y0}]`);
      });
    }
    
    // Grouper les mots par lignes (tolerance Y de 20px)
    const lines = groupWordsByLines(allWords, 30);
    console.log(`📊 ${lines.length} lignes regroupées`);
    
    // Analyser chaque ligne pour trouver nom + score
    const players = [];
    
    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      
      // Chercher un score (nombre avec virgules, 7-13 chiffres)
      const scoreMatch = findScoreInLine(line);
      
      // Chercher un nom de joueur (texte nettoyé)
      const nameMatch = findPlayerNameInLine(line, scoreMatch);
      
      if (scoreMatch && nameMatch) {
        const cleanedName = cleanPlayerNameOCR(nameMatch.text);
        const parsedScore = parseScore(scoreMatch.text);
        
        console.log(`  ✓ Ligne ${i + 1}: "${cleanedName}" → ${parsedScore || 0}`);
        
        players.push({
          lineNumber: i + 1,
          detectedName: cleanedName,
          score: parsedScore,
          confidence: Math.round((nameMatch.confidence + scoreMatch.confidence) / 2),
          hasValidName: cleanedName && cleanedName.length > 0,
          hasValidScore: parsedScore !== null && parsedScore > 0,
          bbox: {
            name: nameMatch.bbox,
            score: scoreMatch.bbox
          }
        });
      }
    }
    
    console.log(`\n✅ ${players.length} joueurs détectés automatiquement`);
    
    return players;
}

/**
 * Groupe les mots par lignes en fonction de leur position Y
 */
function groupWordsByLines(words, tolerance = 30) {
  if (words.length === 0) return [];
  
  // Trier par position Y
  const sortedWords = [...words].sort((a, b) => a.bbox.y0 - b.bbox.y0);
  
  const lines = [];
  let currentLine = [sortedWords[0]];
  let currentY = sortedWords[0].bbox.y0;
  
  for (let i = 1; i < sortedWords.length; i++) {
    const word = sortedWords[i];
    const yDiff = Math.abs(word.bbox.y0 - currentY);
    
    if (yDiff < tolerance) {
      // Même ligne
      currentLine.push(word);
    } else {
      // Nouvelle ligne
      if (currentLine.length > 0) {
        lines.push(currentLine);
      }
      currentLine = [word];
      currentY = word.bbox.y0;
    }
  }
  
  // Ajouter la dernière ligne
  if (currentLine.length > 0) {
    lines.push(currentLine);
  }
  
  // Trier chaque ligne par X
  lines.forEach(line => line.sort((a, b) => a.bbox.x0 - b.bbox.x0));
  
  return lines;
}

/**
 * Trouve un score valide dans une ligne
 * Format: 1,234,567,890 (7 à 13 chiffres avec virgules optionnelles)
 */
function findScoreInLine(words) {
  // Chercher de droite à gauche (scores sont à droite)
  for (let i = words.length - 1; i >= 0; i--) {
    const word = words[i];
    const text = word.text.replace(/\s+/g, '');
    
    // Pattern: chiffres avec virgules optionnelles
    const scorePattern = /^[\d,]+$/;
    
    if (scorePattern.test(text)) {
      // Vérifier que c'est un nombre raisonnable (7-13 chiffres)
      const digitsOnly = text.replace(/,/g, '');
      if (digitsOnly.length >= 7 && digitsOnly.length <= 13) {
        return {
          text: text,
          confidence: word.confidence,
          bbox: word.bbox,
          index: i
        };
      }
    }
  }
  
  return null;
}

/**
 * Trouve un nom de joueur dans une ligne
 * Prend le texte le plus à droite avant le score
 */
function findPlayerNameInLine(words, scoreMatch) {
  if (!scoreMatch) return null;
  
  // Chercher les mots avant le score
  const nameWords = words.slice(0, scoreMatch.index);
  
  if (nameWords.length === 0) return null;
  
  // Filtrer les mots qui ressemblent à des noms
  const validNameWords = nameWords.filter(w => {
    const text = w.text.trim();
    // Ignorer les mots très courts ou les nombres
    if (text.length < 2) return false;
    if (/^\d+$/.test(text)) return false;
    // Ignorer les indicateurs de place
    if (/place|1re|2e|3e|4e|5e/i.test(text)) return false;
    return true;
  });
  
  if (validNameWords.length === 0) return null;
  
  // Prendre les 1-3 derniers mots avant le score (nom du joueur)
  const nameWordsToUse = validNameWords.slice(-3);
  const combinedText = nameWordsToUse.map(w => w.text).join(' ');
  const avgConfidence = nameWordsToUse.reduce((sum, w) => sum + w.confidence, 0) / nameWordsToUse.length;
  
  // Calculer bbox combiné
  const minX = Math.min(...nameWordsToUse.map(w => w.bbox.x0));
  const maxX = Math.max(...nameWordsToUse.map(w => w.bbox.x1));
  const minY = Math.min(...nameWordsToUse.map(w => w.bbox.y0));
  const maxY = Math.max(...nameWordsToUse.map(w => w.bbox.y1));
  
  return {
    text: combinedText,
    confidence: avgConfidence,
    bbox: { x0: minX, y0: minY, x1: maxX, y1: maxY }
  };
}

/**
 * Traite plusieurs screenshots en parallèle
 */
export async function processBatchScreenshotsAuto(screenshots) {
  console.log(`\n🎯 Traitement batch de ${screenshots.length} screenshots (mode auto)`);
  
  const results = await Promise.all(
    screenshots.map(async (screenshot, index) => {
      try {
        console.log(`\n📸 Screenshot ${index + 1}/${screenshots.length}: ${screenshot.filename}`);
        const players = await processGuildRankingScreenshotAuto(screenshot.data);
        
        return {
          index,
          filename: screenshot.filename,
          success: true,
          players
        };
      } catch (error) {
        console.error(`❌ Erreur screenshot ${index + 1}:`, error);
        return {
          index,
          filename: screenshot.filename,
          success: false,
          error: error.message,
          players: []
        };
      }
    })
  );
  
  const successCount = results.filter(r => r.success).length;
  console.log(`\n✅ ${successCount}/${screenshots.length} screenshots traités avec succès`);
  
  return results;
}
