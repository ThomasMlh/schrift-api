# Variables d'environnement
MONGODB_URI=mongodb://localhost:27017
JWT_SECRET=YOU_JWT_SECRET
FRONTEND_URL=
PORT=3000

# Bot Discord (cf. src/utils/notifyDiscord.js et src/utils/botClient.js)
BOT_WEBHOOK_URL=http://localhost:8080
# Secret partagé avec le bot (même valeur que BOT_WEBHOOK_SECRET dans le .env du bot) —
# requis pour GET /api/discord/channels et POST /api/discord/messages, qui échouent en
# 503 tant qu'il n'est pas configuré des deux côtés.
BOT_WEBHOOK_SECRET=
# Character source file on the SFTP (defaults to /database.json)
SFTP_CHARACTERS_PATH=/database.json
# Game master tables (CSV), one sub-folder per client language (fr/, en/...). Local folder in development;
# otherwise read on the FTP (defaults to /game-db)
GAME_DB_DIR=
GAME_DB_FTP_PATH=/game-db
# Language whose dump gives the game data and the pictures without text (defaults to fr)
GAME_PRIMARY_LANGUAGE=fr
# Public URL of the game rmfs folder (character images), with the same language sub-folders
GAME_RMFS_URL=https://bucket.bbs-schrift.fr/rmfs
